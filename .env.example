POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=catalogo_db
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@db:5432/catalogo_db?schema=public
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
API_ADMIN_KEY=replace-with-another-long-random-secret

# Links do painel. Use o endereço do ambiente ao desenvolver localmente.
ADMIN_APP_URL=https://perfumio.app
# Para envio por e-mail, verifique o domínio no Resend e mantenha o rastreamento de cliques desativado.
# No Coolify, configure estas variáveis no ambiente da aplicação.
RESEND_API_KEY=
ADMIN_MAIL_FROM=
